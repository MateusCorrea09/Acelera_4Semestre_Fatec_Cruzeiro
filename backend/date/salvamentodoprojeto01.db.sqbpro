    U.NOME AS Aluno,
    Q.TITULO AS Quiz,
    R.NOTAFINAL AS Nota
FROM resultados R
JOIN USUARIO U ON R.IDALUNO_FK = U.IDUSUARIO
JOIN QUIZ Q ON R.IDQUIZ_FK = Q.IDQUIZ_PK
ORDER BY R.NOTAFINAL DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
